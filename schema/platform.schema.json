{
  "$defs": {
    "Build": {
      "additionalProperties": false,
      "description": "How the image is built.\n\ncontext: service (the default), the service's own folder is the Docker build context; repository, the whole repository\nis, for a service in a monorepo that copies shared code from elsewhere in it (the Dockerfile still lives in the\nservice's folder and its paths are relative to the repository root).\n\nrecipe (docs/ROADMAP.md D31, 13.3): repository (the default), the service's own Dockerfile, else its Procfile through\nGoogle's buildpacks; platform, the platform's own Dockerfile, rendered at build time beside a copy of the service's files\nand never committed; buildpacks, Google's buildpacks even when a Dockerfile exists. entrypoint: the command that starts\nthe service when the platform makes the image (the platform Dockerfile's command, the buildpacks' GOOGLE_ENTRYPOINT).",
      "properties": {
        "context": {
          "default": "service",
          "enum": [
            "service",
            "repository"
          ],
          "title": "Context",
          "type": "string"
        },
        "recipe": {
          "default": "repository",
          "enum": [
            "repository",
            "platform",
            "buildpacks"
          ],
          "title": "Recipe",
          "type": "string"
        },
        "entrypoint": {
          "anyOf": [
            {
              "maxLength": 400,
              "pattern": "^[A-Za-z0-9_./:=,+@%${}() -]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entrypoint"
        }
      },
      "title": "Build",
      "type": "object"
    },
    "Needs": {
      "additionalProperties": false,
      "description": "What the application needs besides its container. Names are short; the platform derives the real resource names.",
      "properties": {
        "buckets": {
          "items": {
            "type": "string"
          },
          "title": "Buckets",
          "type": "array"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        },
        "database": {
          "default": "none",
          "enum": [
            "none",
            "firestore",
            "postgres"
          ],
          "title": "Database",
          "type": "string"
        },
        "migrate": {
          "items": {
            "type": "string"
          },
          "title": "Migrate",
          "type": "array"
        },
        "database_auth": {
          "default": "iam",
          "enum": [
            "iam",
            "password"
          ],
          "title": "Database Auth",
          "type": "string"
        }
      },
      "title": "Needs",
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "default": 1,
          "maximum": 4,
          "minimum": 1,
          "title": "Cpu",
          "type": "integer"
        },
        "memory_mib": {
          "default": 512,
          "maximum": 4096,
          "minimum": 512,
          "title": "Memory Mib",
          "type": "integer"
        }
      },
      "title": "Resources",
      "type": "object"
    },
    "Scaling": {
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum",
          "type": "integer"
        },
        "maximum": {
          "default": 2,
          "maximum": 5,
          "minimum": 1,
          "title": "Maximum",
          "type": "integer"
        }
      },
      "title": "Scaling",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "lab/v1",
      "default": "lab/v1",
      "title": "Api Version",
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9-]{1,19}[a-z0-9]$",
      "title": "Name",
      "type": "string"
    },
    "runtime": {
      "const": "python-http",
      "default": "python-http",
      "title": "Runtime",
      "type": "string"
    },
    "port": {
      "default": 8080,
      "maximum": 65535,
      "minimum": 1024,
      "title": "Port",
      "type": "integer"
    },
    "health_path": {
      "anyOf": [
        {
          "pattern": "^/[A-Za-z0-9/_-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "/health",
      "title": "Health Path"
    },
    "command": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command"
    },
    "args": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Args"
    },
    "resources": {
      "$ref": "#/$defs/Resources"
    },
    "scaling": {
      "$ref": "#/$defs/Scaling"
    },
    "concurrency": {
      "default": 80,
      "maximum": 1000,
      "minimum": 1,
      "title": "Concurrency",
      "type": "integer"
    },
    "exposure": {
      "default": "authenticated",
      "enum": [
        "authenticated",
        "lab-members"
      ],
      "title": "Exposure",
      "type": "string"
    },
    "state": {
      "const": "stateless",
      "default": "stateless",
      "title": "State",
      "type": "string"
    },
    "dependencies": {
      "items": {
        "type": "string"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "gpu": {
      "default": false,
      "title": "Gpu",
      "type": "boolean"
    },
    "env": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Env",
      "type": "object"
    },
    "secrets": {
      "items": {
        "type": "string"
      },
      "title": "Secrets",
      "type": "array"
    },
    "tests": {
      "default": "required",
      "enum": [
        "required",
        "none"
      ],
      "title": "Tests",
      "type": "string"
    },
    "python": {
      "default": "3.12",
      "enum": [
        "3.11",
        "3.12",
        "3.13",
        "3.14",
        "3.15"
      ],
      "title": "Python",
      "type": "string"
    },
    "timeout_seconds": {
      "default": 60,
      "maximum": 300,
      "minimum": 1,
      "title": "Timeout Seconds",
      "type": "integer"
    },
    "needs": {
      "$ref": "#/$defs/Needs"
    },
    "build": {
      "$ref": "#/$defs/Build"
    },
    "reviewed": {
      "default": false,
      "title": "Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "name"
  ],
  "title": "AppSpec",
  "type": "object"
}
