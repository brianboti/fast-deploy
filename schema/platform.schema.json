{
  "$defs": {
    "Build": {
      "additionalProperties": false,
      "description": "How the image is built.\n\ncontext: service (the default), the service's own folder is the Docker build context; repository, the whole repository\nis, for a service in a monorepo that copies shared code from elsewhere in it (the Dockerfile still lives in the\nservice's folder and its paths are relative to the repository root).\n\nrecipe (docs/ROADMAP.md D31, 13.3): repository (the default), the service's own Dockerfile, else its Procfile through\nGoogle's buildpacks; platform, the platform's own Dockerfile, rendered at build time beside a copy of the service's files\nand never committed; buildpacks, Google's buildpacks even when a Dockerfile exists. entrypoint: the command that starts\nthe service when the platform makes the image (the platform Dockerfile's command, the buildpacks' GOOGLE_ENTRYPOINT).",
      "properties": {
        "context": {
          "default": "service",
          "enum": [
            "service",
            "repository"
          ],
          "title": "Context",
          "type": "string"
        },
        "recipe": {
          "default": "repository",
          "enum": [
            "repository",
            "platform",
            "buildpacks"
          ],
          "title": "Recipe",
          "type": "string"
        },
        "entrypoint": {
          "anyOf": [
            {
              "maxLength": 400,
              "pattern": "^[A-Za-z0-9_./:=,+@%${}() &-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entrypoint"
        },
        "network": {
          "default": "default",
          "enum": [
            "default",
            "none"
          ],
          "title": "Network",
          "type": "string"
        },
        "scripts": {
          "items": {
            "type": "string"
          },
          "title": "Scripts",
          "type": "array"
        },
        "user": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        },
        "output": {
          "anyOf": [
            {
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output"
        }
      },
      "title": "Build",
      "type": "object"
    },
    "Job": {
      "additionalProperties": false,
      "description": "A Cloud Run job the service starts itself (docs/ROADMAP.md D64): its own image, identity and limits.\n\ndockerfile: the job's Dockerfile, relative to the service's folder; the folder holding it is the build context.\nbase: an onboarded Node.js application whose test image the platform builds and passes as the build argument BASE (D69).\nOne task, never retried, stopped after timeout_minutes; the controller's guard cancels a run beyond runs_per_day (D70).\nbuckets: the service's declared buckets this job may read or write; models, secrets and env are its own; egress is\nprivate (Google's APIs and the lab's network only) unless the contract says internet.",
      "properties": {
        "dockerfile": {
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*){0,7}$",
          "title": "Dockerfile",
          "type": "string"
        },
        "base": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{1,19}[a-z0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base"
        },
        "command": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "args": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Args"
        },
        "resources": {
          "$ref": "#/$defs/JobResources"
        },
        "timeout_minutes": {
          "default": 10,
          "maximum": 60,
          "minimum": 1,
          "title": "Timeout Minutes",
          "type": "integer"
        },
        "runs_per_day": {
          "default": 30,
          "maximum": 30,
          "minimum": 1,
          "title": "Runs Per Day",
          "type": "integer"
        },
        "buckets": {
          "additionalProperties": {
            "enum": [
              "read",
              "write"
            ],
            "type": "string"
          },
          "title": "Buckets",
          "type": "object"
        },
        "models": {
          "items": {
            "const": "claude",
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "secrets": {
          "items": {
            "type": "string"
          },
          "title": "Secrets",
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env",
          "type": "object"
        },
        "egress": {
          "anyOf": [
            {
              "enum": [
                "private",
                "internet"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Egress"
        }
      },
      "required": [
        "dockerfile"
      ],
      "title": "Job",
      "type": "object"
    },
    "JobResources": {
      "additionalProperties": false,
      "description": "A job's size (docs/ROADMAP.md D67). Cloud Run lets 1 vCPU have up to 4 GiB and 2 vCPUs up to 8 GiB; the lab's policy\nstops at 2 CPUs and 4096 MiB (enforce).",
      "properties": {
        "cpu": {
          "default": 1,
          "maximum": 4,
          "minimum": 1,
          "title": "Cpu",
          "type": "integer"
        },
        "memory_mib": {
          "default": 512,
          "maximum": 8192,
          "minimum": 512,
          "title": "Memory Mib",
          "type": "integer"
        }
      },
      "title": "JobResources",
      "type": "object"
    },
    "Needs": {
      "additionalProperties": false,
      "description": "What the application needs besides its container. Names are short; the platform derives the real resource names.",
      "properties": {
        "buckets": {
          "items": {
            "type": "string"
          },
          "title": "Buckets",
          "type": "array"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        },
        "database": {
          "default": "none",
          "enum": [
            "none",
            "firestore",
            "postgres"
          ],
          "title": "Database",
          "type": "string"
        },
        "migrate": {
          "items": {
            "type": "string"
          },
          "title": "Migrate",
          "type": "array"
        },
        "database_auth": {
          "default": "iam",
          "enum": [
            "iam",
            "password"
          ],
          "title": "Database Auth",
          "type": "string"
        },
        "database_tier": {
          "default": "standard",
          "enum": [
            "standard",
            "ha",
            "sla"
          ],
          "title": "Database Tier",
          "type": "string"
        },
        "mounts": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Mounts",
          "type": "object"
        },
        "models": {
          "items": {
            "const": "claude",
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        }
      },
      "title": "Needs",
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "default": 1,
          "maximum": 4,
          "minimum": 1,
          "title": "Cpu",
          "type": "integer"
        },
        "memory_mib": {
          "default": 512,
          "maximum": 4096,
          "minimum": 512,
          "title": "Memory Mib",
          "type": "integer"
        }
      },
      "title": "Resources",
      "type": "object"
    },
    "Scaling": {
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum",
          "type": "integer"
        },
        "maximum": {
          "default": 2,
          "maximum": 5,
          "minimum": 1,
          "title": "Maximum",
          "type": "integer"
        }
      },
      "title": "Scaling",
      "type": "object"
    },
    "Wake": {
      "additionalProperties": false,
      "description": "The platform's clock (docs/ROADMAP.md D66): the controller sends POST `path` every `every_minutes` as the\napplication's <service>-wake identity, so an application that must look for work runs without an instance kept on.",
      "properties": {
        "path": {
          "maxLength": 200,
          "pattern": "^/[A-Za-z0-9/_-]*$",
          "title": "Path",
          "type": "string"
        },
        "every_minutes": {
          "default": 5,
          "maximum": 60,
          "minimum": 1,
          "title": "Every Minutes",
          "type": "integer"
        }
      },
      "required": [
        "path"
      ],
      "title": "Wake",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "lab/v1",
      "default": "lab/v1",
      "title": "Api Version",
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9-]{1,19}[a-z0-9]$",
      "title": "Name",
      "type": "string"
    },
    "runtime": {
      "default": "python-http",
      "enum": [
        "python-http",
        "node-http",
        "static"
      ],
      "title": "Runtime",
      "type": "string"
    },
    "port": {
      "default": 8080,
      "maximum": 65535,
      "minimum": 1024,
      "title": "Port",
      "type": "integer"
    },
    "health_path": {
      "anyOf": [
        {
          "pattern": "^/[A-Za-z0-9/_-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "/health",
      "title": "Health Path"
    },
    "command": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command"
    },
    "args": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Args"
    },
    "resources": {
      "$ref": "#/$defs/Resources"
    },
    "scaling": {
      "$ref": "#/$defs/Scaling"
    },
    "concurrency": {
      "default": 80,
      "maximum": 1000,
      "minimum": 1,
      "title": "Concurrency",
      "type": "integer"
    },
    "exposure": {
      "default": "authenticated",
      "enum": [
        "authenticated",
        "lab-members"
      ],
      "title": "Exposure",
      "type": "string"
    },
    "proxy": {
      "default": false,
      "title": "Proxy",
      "type": "boolean"
    },
    "state": {
      "const": "stateless",
      "default": "stateless",
      "title": "State",
      "type": "string"
    },
    "dependencies": {
      "items": {
        "type": "string"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "gpu": {
      "default": false,
      "title": "Gpu",
      "type": "boolean"
    },
    "env": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Env",
      "type": "object"
    },
    "secrets": {
      "items": {
        "type": "string"
      },
      "title": "Secrets",
      "type": "array"
    },
    "tests": {
      "default": "required",
      "enum": [
        "required",
        "none",
        "report"
      ],
      "title": "Tests",
      "type": "string"
    },
    "python": {
      "default": "3.12",
      "enum": [
        "3.11",
        "3.12",
        "3.13",
        "3.14",
        "3.15"
      ],
      "title": "Python",
      "type": "string"
    },
    "node": {
      "anyOf": [
        {
          "enum": [
            "22",
            "24",
            "26"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Node"
    },
    "timeout_seconds": {
      "default": 60,
      "maximum": 3600,
      "minimum": 1,
      "title": "Timeout Seconds",
      "type": "integer"
    },
    "needs": {
      "$ref": "#/$defs/Needs"
    },
    "build": {
      "$ref": "#/$defs/Build"
    },
    "trust": {
      "anyOf": [
        {
          "enum": [
            "reviewed",
            "unknown"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trust"
    },
    "egress": {
      "anyOf": [
        {
          "enum": [
            "private",
            "internet"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Egress"
    },
    "domain": {
      "anyOf": [
        {
          "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Domain"
    },
    "project": {
      "anyOf": [
        {
          "enum": [
            "shared",
            "own"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project"
    },
    "jobs": {
      "additionalProperties": {
        "$ref": "#/$defs/Job"
      },
      "title": "Jobs",
      "type": "object"
    },
    "wake": {
      "anyOf": [
        {
          "$ref": "#/$defs/Wake"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reviewed": {
      "default": false,
      "title": "Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "name"
  ],
  "title": "AppSpec",
  "type": "object"
}
