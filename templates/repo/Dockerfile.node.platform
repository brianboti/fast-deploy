# Made by Fast Deploy at build time from the contract (build.recipe: platform, docs/ROADMAP.md 13.3, 21.1 to 21.4); never committed.
# node:__NODE__-trixie-slim (Debian 13) by its multi-architecture index digest, resolved __RESOLVED__.
# tini, the init the platform's images start under (docs/ROADMAP.md 22.2): it forwards SIGTERM to the service and reaps
# what a chained start leaves behind. Downloaded by version and held to its SHA-256 (labdeploy/pins.py follows both).
FROM node:__NODE__-trixie-slim@__DIGEST__ AS init
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN node -e "fetch('https://github.com/krallin/tini/releases/download/v0.19.0/tini-static-amd64').then(r => { if (!r.ok) throw new Error(r.status); return r.arrayBuffer(); }).then(b => require('fs').writeFileSync('/tini', Buffer.from(b)))" \
 && echo "c5b0666b4cb676901f90dfcb37106783c5fe2077b04590973b885950611b30ee  /tini" | sha256sum --check --strict && chmod 0755 /tini

# A build stage: the dependencies, the build and the prune happen here, and only its result enters the image below.
FROM node:__NODE__-trixie-slim@__DIGEST__ AS build
ENV HOME=/tmp
__MANAGER__WORKDIR /app
# Only what passed the platform's deny-list was copied into this build context.
COPY . .
__INSTALL____BUILD____PRUNE__
FROM node:__NODE__-trixie-slim@__DIGEST__
# Libraries read NODE_ENV to run in production mode. The user below has no home directory: what tools write under ~ goes
# to /tmp, memory on Cloud Run.
ENV NODE_ENV=production HOME=/tmp
WORKDIR __WORKDIR__
__FINAL_COPY__# No package manager stays in the image: node itself starts the service, and a manager left behind only brings findings of
# its own to the image's scan.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /usr/local/bin/npm /usr/local/bin/npx \
           /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg /opt/yarn-v*
COPY --from=init /tini /usr/local/bin/tini
# A numeric user that does not exist in the image: the service never runs as root.
USER 65532:65532
EXPOSE __PORT__
ENTRYPOINT ["/usr/local/bin/tini", "-g", "--"]
# node itself, never a package manager: a manager adds latency and does not pass SIGTERM on, so Cloud Run's shutdown would cut requests off.
CMD __CMD__
