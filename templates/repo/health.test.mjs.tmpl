// Drafted by Fast Deploy: checks that GET __HEALTH_PATH__ answers 200, the path the platform probes before and after every
// release. It starts the service as its image does (node __START__) on a free port and stops it afterwards; node --test
// finds it, and the platform runs it before every build.
import assert from 'node:assert/strict';
import { spawn } from 'node:child_process';
import { once } from 'node:events';
import { createServer } from 'node:net';
import { test } from 'node:test';
import { fileURLToPath } from 'node:url';

const root = fileURLToPath(new URL('__ROOT__', import.meta.url));

async function freePort() {
  const probe = createServer().listen(0, '127.0.0.1');
  await once(probe, 'listening');
  const { port } = probe.address();
  probe.close();
  return port;
}

test('GET __HEALTH_PATH__ answers 200', async (t) => {
  const port = await freePort();
  const service = spawn(process.execPath, __ARGS__, { cwd: root, env: { ...process.env, PORT: String(port) }, stdio: 'inherit' });
  t.after(() => service.kill('SIGTERM'));
  let response = null;
  for (let attempt = 0; attempt < 100 && !response; attempt += 1) {
    response = await fetch(`http://127.0.0.1:${port}__HEALTH_PATH__`).catch(() => null);
    if (!response) await new Promise((resolve) => setTimeout(resolve, 100));
  }
  assert.ok(response, 'the service did not answer within 10 seconds');
  assert.equal(response.status, 200);
});
