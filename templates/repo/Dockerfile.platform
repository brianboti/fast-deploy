# Made by Fast Deploy at build time from the contract (build.recipe: platform, docs/ROADMAP.md 13.3); never committed.
# python:__PYTHON__-slim by its multi-architecture index digest, resolved __RESOLVED__.
# tini, the init the platform's images start under (docs/ROADMAP.md 22.2): it forwards SIGTERM to the service and reaps
# what a chained start leaves behind. Downloaded by version and held to its SHA-256 (labdeploy/pins.py follows both).
FROM python:__PYTHON__-slim@__DIGEST__ AS init
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN python -c "import urllib.request; urllib.request.urlretrieve('https://github.com/krallin/tini/releases/download/v0.19.0/tini-static-amd64', '/tini')" \
 && echo "c5b0666b4cb676901f90dfcb37106783c5fe2077b04590973b885950611b30ee  /tini" | sha256sum --check --strict && chmod 0755 /tini

__BUILD_STAGE__FROM python:__PYTHON__-slim@__DIGEST__
# Log lines appear at once. The user below has no home directory: what tools write under ~ (caches, gunicorn's control
# socket, which otherwise logs an error at every start) goes to /tmp, memory on Cloud Run.
ENV PYTHONUNBUFFERED=1 HOME=/tmp__VENV_PATH__
__SYSTEM__WORKDIR /app
__INSTALL__# Only what passed the platform's deny-list was copied into this build context.
COPY . .
__COLLECTSTATIC____TRIM__# A numeric user that does not exist in the image: the service never runs as root.
COPY --from=init /tini /usr/local/bin/tini
USER 65532:65532
EXPOSE __PORT__
ENTRYPOINT ["/usr/local/bin/tini", "-g", "--"]
CMD __CMD__
