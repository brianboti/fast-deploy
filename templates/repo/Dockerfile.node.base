# Made by Fast Deploy at build time (docs/ROADMAP.md D69): the test image of __SERVICE__ at its released commit, for the
# jobs of another application that build on it (their build argument BASE); never committed and never deployed on its own.
# node:__NODE__-trixie-slim (Debian 13) by its multi-architecture index digest, resolved __RESOLVED__. tini, the init the
# platform's images start under, downloaded by version and held to its SHA-256 (labdeploy/pins.py follows both).
FROM node:__NODE__-trixie-slim@__DIGEST__ AS init
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN node -e "fetch('https://github.com/krallin/tini/releases/download/v0.19.0/tini-static-amd64').then(r => { if (!r.ok) throw new Error(r.status); return r.arrayBuffer(); }).then(b => require('fs').writeFileSync('/tini', Buffer.from(b)))" \
 && echo "c5b0666b4cb676901f90dfcb37106783c5fe2077b04590973b885950611b30ee  /tini" | sha256sum --check --strict && chmod 0755 /tini

FROM node:__NODE__-trixie-slim@__DIGEST__
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV HOME=/tmp
# The application's packages only, development dependencies included, apart from any of its code: a job copies the code it
# works on into /work and links /deps/node_modules there. npm stays, since the tests run with it.
WORKDIR /deps
COPY package.json __LOCKFILE__ ./
# The lockfile installed frozen, with every install script off__SCRIPTS_NOTE__.
RUN npm ci --ignore-scripts --no-audit --no-fund__REBUILD__ \
 && npm cache clean --force
RUN mkdir /work && chown 65532:65532 /work
COPY --from=init /tini /usr/local/bin/tini
# A numeric user that does not exist in the image: nothing here runs as root.
USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/tini", "-g", "--"]
