# The infrastructure service's image (docs/INFRASTRUCTURE-ARCHITECTURE.md): Python and the package, nothing else. On
# Google Cloud the service signs in through the metadata server as the machine's service account, so no gcloud CLI is
# needed; on a laptop, run it from the repository instead, where gcloud is.
#   python:3.12-slim multi-arch index digest resolved 2026-10-11, the same as Dockerfile.appdelivery. Refresh both
#   deliberately after review with:  docker buildx imagetools inspect python:3.12-slim
# Build:  docker build -f Dockerfile.cloudinfra -t cloudinfra .     (--platform linux/amd64 for Google Cloud)
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
WORKDIR /app
COPY requirements.lock .
RUN pip install --no-cache-dir --require-hashes -r requirements.lock
COPY cloudinfra ./cloudinfra
# The state file, its lock and the log live under /data; the configuration is mounted at /config.
RUN mkdir /data && chown 65532:65532 /data
USER 65532:65532
ENV CLOUDINFRA_CONFIG=/config/cloudinfra.yaml
EXPOSE 8100
# Behind a reverse proxy set FORWARDED_ALLOW_IPS to the proxy's address (uvicorn reads it), or every caller looks like
# the proxy and the per-address limits collapse into one.
CMD ["uvicorn", "cloudinfra.mcp.server:create_app", "--factory", "--host", "0.0.0.0", "--port", "8100"]
