# Foundation root: the project-wide resources every application shares (APIs, observer and pipeline identities, cost
# controls, alert channels, the spending cap). The operator applies this root; it changes rarely. Each application has
# its own root under ../apps, generated by `lab-deploy infra render` and applied by the pipeline (see docs/SETUP.md 7f).
terraform {
  required_version = ">= 1.6, < 2.0"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 7.0"
    }
  }
  backend "gcs" {}
}
