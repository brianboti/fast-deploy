# Generated by `lab-deploy infra render jobs-demo` from the controller configuration and the app's platform.yaml.
# Change those sources and render again; the pipeline plans this root on a pull request and applies it on merge.
provider "google" {
  project = "lab-deploy-staging-f29a"
  region  = "us-central1"
}

# Project-wide values (identities, channels, roles) come from the foundation root's state, read-only.
data "terraform_remote_state" "project" {
  backend = "gcs"
  config = {
    bucket = "lab-deploy-staging-f29a-tfstate"
    prefix = "project/staging"
  }
}

module "service" {
  source                       = "../../modules/service"
  project_id                   = "lab-deploy-staging-f29a"
  region                       = "us-central1"
  service                      = "jobs-demo"
  github_repository            = "brianboti/fast-deploy-jobs-trial"
  github_repository_id         = "1428936595"
  github_owner_id              = "207480197"
  bootstrap_image              = "us-docker.pkg.dev/cloudrun/container/hello@sha256:ea86b59c787261f424f9de114900e598f19e036c73aa95ff12b6ad5f022122fd"
  health_path                  = "/health"
  image_versions_to_keep       = 10
  image_retention_days         = 180
  registry_cleanup_dry_run     = true
  runtime_alerts               = true
  error_alert_count            = 5
  latency_alert_ms             = 2000
  instance_alert_count         = 2
  exposure                     = "authenticated"
  viewers                      = []
  needs                        = { buckets = ["runs"], topics = [], database = "none", migrate = [] }
  project_number               = data.terraform_remote_state.project.outputs.project_number
  image_vulnerability_scanning = data.terraform_remote_state.project.outputs.image_vulnerability_scanning
  tag_manager_role             = data.terraform_remote_state.project.outputs.tag_manager_role
  alert_channels               = data.terraform_remote_state.project.outputs.alert_channels
  cap_service_account          = data.terraform_remote_state.project.outputs.cap_service_account
  billing_dataset              = data.terraform_remote_state.project.outputs.billing_dataset
  network                      = data.terraform_remote_state.project.outputs.network
  subnet                       = data.terraform_remote_state.project.outputs.subnet
  cap_operator_role            = data.terraform_remote_state.project.outputs.cap_operator_role
  iap_client_id                = try(data.terraform_remote_state.project.outputs.iap_client_id, "")
  kms_key_ring                 = try(data.terraform_remote_state.project.outputs.kms_key_ring, "")
  binary_authorization         = try(data.terraform_remote_state.project.outputs.binary_authorization, null)
  jobs                         = { "worker" = { "cpu" = 1, "memory_mib" = 512, "timeout_minutes" = 5, "buckets" = { "runs" = "write" }, "models" = [], "secrets" = [] }, "checker" = { "cpu" = 1, "memory_mib" = 1024, "timeout_minutes" = 5, "buckets" = { "runs" = "read" }, "models" = [], "secrets" = [] } }
  wake                         = true
  controller_members           = try(data.terraform_remote_state.project.outputs.controller_members, [])
  job_guard_role               = try(data.terraform_remote_state.project.outputs.job_guard_role, "")
}
